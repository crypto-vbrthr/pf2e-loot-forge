<section class="lf-standalone-shell">
  <div class="lf-embedded-host" data-lf-embedded-host></div>

  <section class="lf-standalone-container-actions">
    <div class="lf-target-box lf-standalone-target-box">
      <h3>{{lf "LF.App.Target"}}</h3>
      <div class="form-group lf-target-actor-drop" data-lf-target-actor-drop>
        <label>{{lf "LF.Field.TargetActor"}}</label>
        <select name="targetActorId">
          <option value="">{{lf "LF.Target.None"}}</option>
          {{#each actors}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{#if isLoot}}🪙 {{/if}}{{name}} — {{typeLabel}}</option>
          {{/each}}
        </select>
        <p class="notes lf-drop-hint">
          <i class="fa-solid fa-hand-pointer"></i>
          {{lf "LF.TargetActor.DropHint"}}
        </p>
        {{#if droppedTargetActor}}
          <p class="notes lf-drop-selection">
            {{lf "LF.TargetActor.SelectedByDrop"}}: <strong>{{droppedTargetActor.name}}</strong>
          </p>
        {{/if}}
      </div>
      <div class="form-group">
        <label>{{lf "LF.Field.NewLootActorName"}}</label>
        <input type="text" name="newLootActorName" value="{{newLootActorName}}">
      </div>
    </div>

    <footer class="lf-actions lf-container-actions">
      <button type="button" data-action="apply" {{#unless hasResult}}disabled{{/unless}}><i class="fa-solid fa-box-open"></i> {{lf "LF.Button.ApplyToActor"}}</button>
      <button type="button" data-action="create-loot-actor" {{#unless hasResult}}disabled{{/unless}}><i class="fa-solid fa-coins"></i> {{lf "LF.Button.CreateLootActor"}}</button>
    </footer>
  </section>
</section>
